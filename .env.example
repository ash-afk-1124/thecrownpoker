# Copy to .env for local use (`cp .env.example .env`), or set these in your host's dashboard.

# Port to listen on. Most hosts (Render, Railway, Fly, Heroku-style) set this for you.
PORT=3001

# Public address of the game, used to build invite links like https://poker.example.com/room/482913.
# Leave empty to use whatever address the browser connected to.
PUBLIC_URL=https://poker.example.com

# Seconds each player has to act before auto check/fold.
TURN_SECONDS=30

# Pause between the end of a hand and the next deal, in seconds.
NEXT_HAND_SECONDS=6

# Only needed if the React client is hosted on a different origin than this server (comma-separated).
# CORS_ORIGINS=https://www.example.com
